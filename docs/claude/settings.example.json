{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/quiet-go.sh\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(scripts/check.sh)",
      "Bash(scripts/test.sh)",
      "Bash(scripts/test.sh *)",
      "Bash(scripts/run-quiet.sh *)",
      "Bash(make check)",
      "Bash(make test)",
      "Bash(make vet)",
      "Bash(make build)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go build *)",
      "Bash(gofmt -l *)",
      "Bash(git status)",
      "Bash(git diff --stat *)",
      "Bash(git log --oneline *)"
    ]
  }
}
